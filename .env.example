# ClaimTrace - plantilla de variables de entorno
# Copia este archivo a .env y sustituye los valores.
# .env NO se sube al repositorio. Este archivo SI, y nunca debe llevar valores reales.

# --- Base de datos (servicio "db": Postgres + pgvector) ---

# Usuario de la base de datos
POSTGRES_USER=claimtrace
# Contraseña: cámbiala en tu .env local, aquí solo un marcador
POSTGRES_PASSWORD=change_me
# Nombre de la base que guarda vectores de políticas y registro de auditoría
POSTGRES_DB=claimtrace
# Dentro de la red de Docker el "host" es el nombre del servicio, no localhost
POSTGRES_HOST=db
# Puerto de Postgres dentro de la red de Docker
POSTGRES_PORT=5432
# Puerto de Postgres en TU máquina, publicado solo en 127.0.0.1.
# Si el 5432 ya lo usa otro Postgres en tu PC, este valor evita el choque.
POSTGRES_HOST_PORT=5433

# --- API (servicio "api": agente, RAG y LangGraph) ---
# Reservadas para el Bloque 8: n8n todavía no está en el compose.
# Puerto en el que se publica la API en tu máquina
API_PORT=8000

# --- n8n (servicio "n8n": capa de entrada) ---
# Puerto en el que se publica n8n en tu máquina
N8N_PORT=5678
# Clave con la que n8n cifra sus credenciales: cámbiala en tu .env local
N8N_ENCRYPTION_KEY=change_me

# --- Modelo de lenguaje (por definir en los Bloques 4 y 5) ---
# Clave del proveedor de LLM que se elija. Se deja vacía hasta entonces.
LLM_API_KEY=